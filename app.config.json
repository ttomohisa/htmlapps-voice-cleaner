{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Voice Cleaner",
  "nameJa": "Voice Cleaner",
  "slug": "voice-cleaner",
  "version": "1.0.0",
  "description": "Remove background noise from recorded speech locally in the browser.",
  "descriptionJa": "録音の背景ノイズを端末内で軽減し、処理前後を比較して保存します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-voice-cleaner"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
