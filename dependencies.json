{
  "$schema": "./schemas/dependencies.schema.json",
  "dependencies": [
    {
      "id": "gtcrn-wasm",
      "package": "@sapphi-red/gtcrn-wasm",
      "version": "0.0.3",
      "license": "MIT",
      "homepage": "https://github.com/sapphi-red/gtcrn-wasm",
      "updates": {
        "enabled": true,
        "policy": "manual"
      },
      "assets": [
        {
          "key": "main",
          "path": "dist/index.js",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "auto"
        },
        {
          "key": "wasm",
          "path": "dist/gtcrn.wasm",
          "mime": "application/wasm",
          "compression": "auto"
        }
      ]
    }
  ]
}
